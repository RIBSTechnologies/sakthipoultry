# SMTP — Zoho Mail (form submissions emailed to MAIL_TO)
SMTP_HOST=smtppro.zoho.in
SMTP_PORT=465
SMTP_USER=enquiry@sakthipoultry.com
SMTP_PASS=your-mailbox-password
MAIL_FROM="Sakthi Poultry <enquiry@sakthipoultry.com>"
MAIL_TO=enquiry@sakthipoultry.com

# Optional — use if direct SMTP from Vercel is blocked.
# MAIL_RELAY_URL=
# MAIL_RELAY_SECRET=

# Public site URL (production)
NEXT_PUBLIC_SITE_URL=https://sakthipoultry.vercel.app

# Optional — signs captcha tokens (defaults to SMTP_PASS when unset)
CAPTCHA_SECRET=your-random-secret
