# SMTP — form submissions are emailed to MAIL_TO
SMTP_HOST=md-92.webhostbox.net
SMTP_PORT=465
SMTP_USER=enquiry@sakthipoultry.com
SMTP_PASS=your-mailbox-password
MAIL_FROM=enquiry@sakthipoultry.com
MAIL_TO=enquiry@sakthipoultry.com

# Optional — use if direct SMTP from Vercel is unreliable.
# Upload scripts/cpanel-mail-relay.php to your webhostbox/cPanel site first.
MAIL_RELAY_URL=https://your-domain.com/sp-mail-relay.php
MAIL_RELAY_SECRET=choose-a-long-random-secret

# Public site URL (production)
NEXT_PUBLIC_SITE_URL=https://sakthipoultry.vercel.app

# Optional — signs captcha tokens (defaults to SMTP_PASS when unset)
CAPTCHA_SECRET=your-random-secret
