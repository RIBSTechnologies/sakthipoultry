# SMTP — form submissions are emailed to MAIL_TO
SMTP_HOST=md-92.webhostbox.net
SMTP_PORT=465
SMTP_USER=enquiry@sakthipoultry.com
SMTP_PASS=your-mailbox-password
MAIL_FROM=enquiry@sakthipoultry.com
MAIL_TO=enquiry@sakthipoultry.com

# Public site URL (production)
NEXT_PUBLIC_SITE_URL=https://sakthipoultry.vercel.app

# Cloudflare Turnstile — advanced captcha for all contact forms
# Create keys at https://dash.cloudflare.com/?to=/:account/turnstile
# Test keys (always pass): site 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key
